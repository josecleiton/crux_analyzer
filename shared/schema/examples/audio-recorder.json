{
  "project": "Audio Recorder",
  "cores": [
    {
      "name": "Recorder",
      "machines": [
        {
          "name": "RecorderState",
          "states": ["Idle", "Recording", "Paused", "Uploading", "Completed"],
          "transitions": [
            { "from": "Idle", "event": "RecordPressed", "to": "Recording", "effects": ["AudioOperation::Start"] },
            { "from": "Recording", "event": "PausePressed", "to": "Paused", "effects": ["AudioOperation::Pause"] },
            { "from": "Paused", "event": "ResumePressed", "to": "Recording", "effects": ["AudioOperation::Resume"] },
            { "from": "Recording", "event": "StopPressed", "to": "Uploading", "effects": ["AudioOperation::Stop", "HttpOperation::Upload"] },
            { "from": "Uploading", "event": "UploadFinished", "to": "Completed", "effects": ["Render"] }
          ]
        },
        {
          "name": "InputState",
          "states": ["Ready", "Switching"],
          "transitions": [
            { "from": "Ready", "event": "InputSelected", "to": "Switching", "effects": ["AudioOperation::SwitchInput"] },
            { "from": "Switching", "event": "InputSwitched", "to": "Ready", "effects": ["Render"] },
            { "from": "*", "event": "InputsInvalidated", "to": "Ready" }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "machines": [
        {
          "name": "AuthState",
          "states": [
            "SignedOut",
            "Authenticating",
            "SignedIn",
            {
              "name": "Failed",
              "doc": "Authentication was refused by the server.\n\nThe credentials are kept, so the user can retry without typing them again.",
              "markers": ["failure"],
              "tags": ["retryable"]
            }
          ],
          "transitions": [
            { "from": "SignedOut", "event": "LoginPressed", "to": "Authenticating" },
            { "from": "Authenticating", "event": "AuthSucceeded", "to": "SignedIn" },
            { "from": "Authenticating", "event": "AuthFailed", "to": "Failed" },
            { "from": "Failed", "event": "RetryPressed", "to": "Authenticating" },
            { "from": "SignedIn", "event": "LogoutPressed", "to": "SignedOut" }
          ]
        }
      ]
    },
    {
      "name": "Sync",
      "machines": [
        {
          "name": "SyncState",
          "doc": "Mirrors finished recordings to the server, one device at a time.",
          "states": [
            "Idle",
            "Syncing",
            {
              "name": "Conflict",
              "doc": "The server copy changed too; someone has to choose which one wins.",
              "tags": ["manual-resolution"]
            },
            { "name": "Done", "markers": ["deprecated"] }
          ],
          "transitions": [
            { "from": "Idle", "event": "SyncRequested", "to": "Syncing" },
            { "from": "Syncing", "event": "ConflictDetected", "to": "Conflict" },
            { "from": "Conflict", "event": "ConflictResolved", "to": "Syncing" },
            { "from": "Syncing", "event": "SyncFinished", "to": "Done" },
            { "from": "Done", "event": "SyncRequested", "to": "Syncing" }
          ]
        }
      ]
    }
  ]
}

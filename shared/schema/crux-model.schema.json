{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crux-analyzer.dev/schemas/crux-model.schema.json",
  "title": "CruxModel",
  "description": "Contract of the semantic model emitted by the parser. The UI and every other client depend only on this contract.",
  "type": "object",
  "required": ["project", "cores"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "description": "Name of the analyzed project."
    },
    "cores": {
      "type": "array",
      "items": { "$ref": "#/$defs/core" }
    }
  },
  "$defs": {
    "core": {
      "type": "object",
      "required": ["name", "machines"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the Core (Crux app)."
        },
        "machines": {
          "type": "array",
          "description": "State machines (orthogonal regions) of this Core — one per state enum, statechart style.",
          "items": { "$ref": "#/$defs/machine" }
        }
      }
    },
    "machine": {
      "type": "object",
      "required": ["name", "states", "transitions"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the state machine (usually the state enum's name)."
        },
        "states": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Leaf states of the machine. Children of composite (hierarchical) states are encoded as `Parent/Child` paths."
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["from", "event", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "Source state, or \"*\" meaning any state."
        },
        "event": { "type": "string", "description": "Event that triggers the transition." },
        "to": {
          "type": "string",
          "description": "Target state, or \"*\" when the target is decided at runtime (e.g. carried by the event payload)."
        },
        "effects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Effects requested when this transition fires (e.g. \"Render\", \"AudioOperation::Start\")."
        }
      }
    }
  }
}
